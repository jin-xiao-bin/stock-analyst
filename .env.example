# ========== 数据库（必填）==========
MYSQL_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/stock_analyst?charset=utf8mb4

# 可选缓存（不配则自动降级直查 MySQL）
REDIS_URL=

# 可选向量库（不配则报告检索降级跳过）
MILVUS_URI=

# ========== 数据源（必填）==========
# Tushare Pro token（https://tushare.pro 注册获取）
TUSHARE_TOKEN=
# 自定义 API 地址（官方为 https://api.tushare.pro；如使用中转服务填写中转地址）
TUSHARE_API_URL=https://api.tushare.pro
TUSHARE_MAX_PER_MIN=200

# ========== LLM（必填）==========
# DeepSeek API（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-chat
REASONER_MODEL=deepseek-reasoner

# ========== 搜索（可选，不配则新闻降级）==========
# 博查 AI 搜索（https://bocha.ai）
BOCHA_API_KEY=

# ========== 本地向量模型（可选）==========
# bge-m3 模型本地路径（https://huggingface.co/BAAI/bge-m3 下载后填写）
BGE_M3_PATH=

# ========== 飞书通知/指令（可选）==========
# 群自定义机器人 Webhook（单向通知）
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
# 自建应用（双向指令，需开通 im:message 权限 + 长连接事件订阅）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ========== 模拟交易费用规则（可选，默认如下）==========
COMMISSION_RATE=0.00025
COMMISSION_MIN=5.0
STAMP_TAX_RATE=0.001
